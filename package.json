{
	"name": "jwoo-cli",
	"version": "0.0.0",
	"description": "Terminal dashboard for personal activity telemetry",
	"license": "MIT",
	"type": "module",
	"bin": "./dist/cli.js",
	"engines": {
		"node": ">=22.20.0"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsc --project tsconfig.build.json --watch",
		"test": "prettier --check . && xo && tsc --noEmit && ava"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"telemetry",
		"tui",
		"ink"
	],
	"dependencies": {
		"ink": "^7.1.1",
		"meow": "^14.1.0",
		"mongodb": "^7.6.0",
		"react": "^19.3.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/node": "^22.20.4",
		"@types/react": "^19.3.0",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^8.0.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"ink-testing-library": "^4.0.0",
		"prettier": "^3.9.8",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"xo": "^5.0.1"
	},
	"ava": {
		"extensions": [
			"ts",
			"tsx"
		],
		"nodeArguments": [
			"--import",
			"tsx",
			"--disable-warning=ExperimentalWarning"
		]
	},
	"prettier": "@vdemedes/prettier-config"
}
